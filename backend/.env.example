# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (Supabase). Falls back to local SQLite if unset.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT signing secret - generate a long random value for production.
JWT_SECRET_KEY=change-me-to-a-long-random-value

# Public app URL, used to build links inside transactional emails.
APP_BASE_URL=http://localhost:3000

# Email provider: "resend" or "console" (console just logs, no real send)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Tivuta <no-reply@tivuta.co.il>

# WhatsApp provider: "meta_cloud" or "console"
WHATSAPP_PROVIDER=console
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Error monitoring (Sentry) — leave blank to disable
SENTRY_DSN=
